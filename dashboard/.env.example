# Dashboard environment variables — copy to .env.local for local development

# Backend API base URL
VITE_API_URL=http://localhost:4000/api/v1

# GitHub App slug name (shown in the URL: github.com/apps/<name>)
# Used to generate the "Install GitHub App" link in Settings -> Autofix Repository
VITE_GITHUB_APP_NAME=your-github-app-name
