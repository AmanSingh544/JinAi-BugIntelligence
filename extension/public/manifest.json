{
  "manifest_version": 3,
  "name": "Bug Intelligence",
  "version": "1.0.0",
  "description": "AI-powered bug capture and intelligence platform",

  "permissions": ["storage", "activeTab", "scripting", "alarms", "tabs", "offscreen"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/error-tracker.js",
        "content/network-tracker.js",
        "content/console-tracker.js",
        "content/dom-tracker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Bug Intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
