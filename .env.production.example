# ── Copy to .env.production and fill in ──────────────────────────────────────
# Plan A = local Postgres on the VM (COMPOSE_PROFILES=with-db)
# Plan B = Neon serverless Postgres (leave COMPOSE_PROFILES empty)

# ── Host ──────────────────────────────────────────────────────────────────────
# Free options: yourname.duckdns.org (DuckDNS), or your own domain
DOMAIN=yourname.duckdns.org

# Plan A only — uncomment to run Postgres on this VM:
# COMPOSE_PROFILES=with-db

# ── Database ─────────────────────────────────────────────────────────────────
# Plan A (local container; POSTGRES_PASSWORD is used by the postgres service):
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_16
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/bug_intelligence?schema=public

# Plan B (Neon) — replace the two lines above with:
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── App ──────────────────────────────────────────────────────────────────────
PORT=4000
# Generate: openssl rand -hex 32  (the app refuses nothing — but a guessable
# secret means forgeable logins; NEVER ship the default)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRATION=15m
ALLOWED_ORIGINS=https://${DOMAIN}
DASHBOARD_URL=https://${DOMAIN}

# ── AI ───────────────────────────────────────────────────────────────────────
AI_API_KEY=CHANGE_ME
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Optional: enables semantic clustering + /similar (needs an embeddings
# provider — Groq has none; OpenAI's text-embedding-3-small works)
# AI_EMBEDDING_MODEL=

# ── Optional: email (password reset / verification) ──────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Bug Intelligence <accounts@yourdomain>"

# ── Optional: autofix GitHub App ─────────────────────────────────────────────
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
