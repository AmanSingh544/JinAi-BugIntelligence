# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bug_intelligence?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# JWT (dashboard auth)
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRATION="7d"

# AI provider — works with OpenAI, OpenRouter, Cerebras, Anthropic (/v1), or any OpenAI-compatible endpoint
AI_API_KEY="sk-..."
# AI_BASE_URL="https://openrouter.ai/api/v1"     # omit for OpenAI, set for others
# AI_BASE_URL="https://api.cerebras.ai/v1"        # Cerebras
# AI_BASE_URL="https://api.anthropic.com/v1"      # Anthropic via OpenAI-compat layer
# Comma-separated fallback chain — tried left to right until one succeeds
AI_MODELS="google/gemini-2.0-flash-exp:free,google/gemini-2.5-pro-exp-03-25:free,meta-llama/llama-4-scout:free,mistralai/mistral-7b-instruct:free"
# AI_MODEL="gpt-4o-mini"   # single model (legacy, still works)
# AI_EMBEDDING_MODEL="text-embedding-3-small"     # optional, enables semantic clustering

# Meridian 3SC Integration (optional)
MERIDIAN_BASE_URL="http://localhost:3000"
