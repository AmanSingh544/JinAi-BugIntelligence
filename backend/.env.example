# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bug_intelligence?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# JWT (dashboard auth)
JWT_SECRET="change-me-in-production-use-long-random-string"

# AI provider — works with OpenAI, OpenRouter, Cerebras, Anthropic (/v1), or any OpenAI-compatible endpoint
AI_API_KEY="sk-..."
# AI_BASE_URL="https://openrouter.ai/api/v1"     # omit for OpenAI, set for others
# AI_BASE_URL="https://api.cerebras.ai/v1"        # Cerebras
# AI_BASE_URL="https://api.anthropic.com/v1"      # Anthropic via OpenAI-compat layer
# Comma-separated fallback chain — tried left to right until one succeeds
AI_MODELS="google/gemini-2.0-flash-exp:free,google/gemini-2.5-pro-exp-03-25:free,meta-llama/llama-4-scout:free,mistralai/mistral-7b-instruct:free"
# AI_MODEL="gpt-4o-mini"   # single model (legacy, still works)
# AI_EMBEDDING_MODEL="text-embedding-3-small"     # optional, enables semantic clustering

# SMTP (used for auth emails and bug notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="password"
SMTP_FROM="Bug Intelligence Accounts <accounts@bugintelligence.local>"

# Dashboard URL (used in email links and OAuth callbacks)
DASHBOARD_URL="http://localhost:5173"


# OAuth (optional — enables Google/GitHub login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/v1/auth/github/callback"

# Meridian 3SC Integration (optional)
MERIDIAN_BASE_URL="http://localhost:3000"

# ─── GitHub App (Autofix pipeline) ───────────────────────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new
# Required permissions: Contents (R/W), Pull Requests (R/W), Statuses (R)
# Set webhook URL to: https://your-domain.com/api/v1/webhooks/github
GITHUB_APP_ID=""
# Paste the full PEM private key (newlines as \n or multiline)
GITHUB_APP_PRIVATE_KEY=""
# Random secret used to verify incoming GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=""
# Slug name of your GitHub App (shown in the URL: github.com/apps/<name>)
GITHUB_APP_NAME=""

# Autofix tuning (optional — defaults shown)
# AUTOFIX_MAX_ATTEMPTS=3
# AUTOFIX_FIX_CONFIDENCE_MIN=0.75
# AUTOFIX_SANDBOX_ENABLED=false
# AUTOFIX_SANDBOX_TIMEOUT_MS=30000
# AUTOFIX_STALE_PR_DAYS=7   # Days before an open autofix PR is considered stale and closed
